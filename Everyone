<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Everyone’s Voice Hub</title>
<style>
  body { margin:0; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; background:#f6f4e8; color:#17342b; }
  header { background:linear-gradient(135deg,#17513f,#2f7a5a); color:#fff; padding:18px 24px; }
  header h1 { margin:0; font-size:24px; }
  header p { margin:4px 0 0; }
  nav { display:flex; flex-wrap:wrap; justify-content:center; gap:8px; padding:12px 20px; background:#d9e2c3; }
  nav button { background:#fff; border:2px solid #17513f; color:#17513f; padding:8px 12px;
               border-radius:20px; cursor:pointer; font-size:15px; }
  nav button.on { background:#17513f; color:#fff; }
  main { max-width:920px; margin:0 auto; padding:16px 20px 40px; }
  section { display:none; }
  section.on { display:block; }
  label { display:block; margin:12px 0 4px; font-weight:bold; }
  textarea, input, select { width:100%; box-sizing:border-box; padding:8px; font-size:16px;
                            border:2px solid #7a9a85; border-radius:8px; }
  .row { display:flex; gap:12px; flex-wrap:wrap; }
  .row label { display:inline; font-weight:normal; }
  .row input { width:auto; }
  button.act { background:#17513f; color:#fff; border:0; padding:10px 16px; border-radius:8px;
               font-size:16px; cursor:pointer; margin:8px 8px 0 0; }
  button.alt { background:#fff; color:#17513f; border:2px solid #17513f; }
  button:focus, input:focus, textarea:focus, select:focus { outline:3px solid #f2b705; }
  .card { background:#fff; border-radius:12px; padding:12px 14px; margin:10px 0; box-shadow:0 2px 8px rgba(23,81,63,.12);
          border-left:6px solid #7aa874; }
  .card small { color:#4b6358; }
  canvas { background:#fff; border:2px solid #7a9a85; border-radius:8px; touch-action:none;
           max-width:100%; }
  #msg { padding:10px 20px; background:#fff3c4; display:none; }
  .feel { background:#fff; border:2px solid #7a9a85; border-radius:20px; padding:8px 12px;
          cursor:pointer; font-size:16px; margin:4px 4px 0 0; }
  .feel.on { background:#17513f; color:#fff; border-color:#17513f; }
  nav button.member { font-size:16px; }
  .hero { display:flex; flex-wrap:wrap; align-items:center; gap:20px; padding:24px; margin-bottom:18px; background:linear-gradient(135deg,#fbfaf0,#e8efd4); border-radius:24px; box-shadow:0 4px 18px rgba(23,81,63,.12); }
  .hero .txt { flex:1 1 280px; }
  .hero h2 { font-size:2em; line-height:1.15; margin:0 0 12px; }
  .hero .art { flex:1 1 320px; max-width:520px; }
  .hero svg { width:100%; height:auto; display:block; }
  .boxes { display:flex; flex-wrap:wrap; gap:16px; }
  .box { flex:1 1 280px; background:#e4ebd0; border-radius:16px; padding:16px 18px; }
  .box.light { background:#efe9d6; }
  .box h3 { margin:0 0 8px; }
  .box ul { margin:0; padding-left:20px; columns:2; }
  .eye { transform-box:fill-box; transform-origin:center; animation:blink 4.5s infinite; }
  @keyframes blink { 0%,92%,100% { transform:scaleY(1); } 95% { transform:scaleY(.08); } }
  .bob { animation:bob 4s ease-in-out infinite; }
  @keyframes bob { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-5px); } }
  .bub { opacity:0; animation:say 16s infinite both; }
  .b2 { animation-delay:4s; } .b3 { animation-delay:8s; } .b4 { animation-delay:12s; }
  @keyframes say { 0% { opacity:0; transform:translateY(6px); } 3%,22% { opacity:1; transform:translateY(0); } 25%,100% { opacity:0; transform:translateY(0); } }
  .float { animation:float 5s ease-in-out infinite alternate; }
  @keyframes float { from { transform:translateY(0); } to { transform:translateY(-8px); } }
  .wave { transform-origin:487px 222px; animation:wave 1.6s ease-in-out infinite alternate; }
  @keyframes wave { from { transform:rotate(-8deg); } to { transform:rotate(14deg); } }
  .cane { transform-origin:256px 262px; animation:tap 3s ease-in-out infinite alternate; }
  @keyframes tap { from { transform:rotate(-4deg); } to { transform:rotate(5deg); } }
  .spin { transform-origin:296px 298px; animation:spin 14s linear infinite; }
  @keyframes spin { to { transform:rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .eye,.bob,.float,.wave,.cane,.spin { animation:none; }
    .bub { animation:none; opacity:0; } .b1 { opacity:1; }
  }
  .art { position:relative; }
  .pic { display:block; width:100%; height:auto; border-radius:20px; background:#f6f5ee; }
  .pic.bob { animation:bob 5s ease-in-out infinite; }
  header { position:relative; overflow:hidden; padding:18px 24px 54px;
           background:linear-gradient(135deg,#17513f,#2f7a5a,#1f6b6b,#17513f); background-size:300% 300%;
           animation:hdrShift 18s ease-in-out infinite; }
  @keyframes hdrShift { 0%,100% { background-position:0% 50%; } 50% { background-position:100% 50%; } }
  header h1, header p { position:relative; z-index:1; }
  .brand { display:flex; align-items:center; gap:14px; position:relative; z-index:1; }
  .logo { width:58px; height:58px; padding:0; border:0; border-radius:50%; background:none; cursor:pointer;
          flex:none; transition:transform .2s; box-shadow:0 2px 8px rgba(0,0,0,.25); }
  .logo:hover { transform:scale(1.08) rotate(-4deg); }
  .logo svg { width:100%; height:100%; display:block; }
  .waves { position:absolute; left:0; bottom:0; width:200%; height:46px; fill:rgba(255,255,255,.16); animation:drift 16s linear infinite; }
  .waves.w2 { height:32px; fill:rgba(255,255,255,.12); animation-duration:11s; animation-direction:reverse; }
  @keyframes drift { from { transform:translateX(0); } to { transform:translateX(-50%); } }

  .calmbox { background:#fff; border-radius:16px; padding:14px; box-shadow:0 2px 8px rgba(23,81,63,.12); margin-top:12px; }
  .gbar { display:flex; gap:18px; flex-wrap:wrap; font-weight:bold; margin-bottom:8px; }
  .overlay { position:absolute; inset:0; z-index:5; display:flex; flex-direction:column; align-items:center;
             justify-content:center; text-align:center; gap:6px; padding:16px; background:rgba(255,255,255,.88); border-radius:14px; }
  #bubField { position:relative; height:300px; border-radius:14px; overflow:hidden; touch-action:manipulation;
              background:linear-gradient(180deg,#d6ecf3,#dfe8c8); }
  .pop { position:absolute; bottom:-90px; border-radius:50%; border:2px solid rgba(255,255,255,.85); cursor:pointer;
         padding:0; font-size:22px; color:#8a6500; box-shadow:inset -6px -6px 12px rgba(255,255,255,.55);
         animation:rise var(--d,4s) linear forwards; }
  .pop.gold { background:radial-gradient(circle,#fff6b0,#f2b705); }
  @keyframes rise { from { bottom:-90px; } to { bottom:100%; } }
  #whackWrap { position:relative; padding:8px; }
  #whackGrid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; max-width:360px; margin:0 auto; }
  .hole { height:88px; font-size:42px; border-radius:50%; border:0; cursor:pointer; padding:0;
          background:radial-gradient(circle at 50% 60%,#6b4a2b,#a08058); box-shadow:inset 0 6px 10px rgba(0,0,0,.35); }
  #smashArea { position:relative; height:230px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; }
  #hpBar { width:60%; height:12px; background:#e3e3e3; border-radius:8px; overflow:hidden; }
  #hpFill { height:100%; width:100%; background:#d9534f; transition:width .15s; }
  #smashBlock { background:#f4b6c2; border:3px solid #17513f; border-radius:16px; padding:16px 22px; font-size:20px;
                font-weight:bold; cursor:pointer; max-width:90%; color:#17342b; }
  #smashBlock.hit { animation:shake .18s; }
  @keyframes shake { 0%,100% { transform:translateX(0); } 25% { transform:translateX(-8px) rotate(-2deg); } 75% { transform:translateX(8px) rotate(2deg); } }
  .bit { position:absolute; left:50%; top:50%; font-size:22px; transition:transform .8s ease-out, opacity .8s; pointer-events:none; }
  @media (prefers-reduced-motion: reduce) { header, .waves, #smashBlock.hit { animation:none; } }
  .hide { display:none; }
</style>
</head>
<body>

<header>
  <div class="brand">
    <button class="logo" id="logoBtn" aria-label="Everyone’s Voice Hub, go to home page" title="Go to home page">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <circle cx="32" cy="32" r="31" fill="#fff"/>
        <rect x="14" y="16" width="36" height="27" rx="12" fill="#17513f"/>
        <path d="M22 41 L19 53 L32 42Z" fill="#17513f"/>
        <path d="M32 38 C22 31 25 23 30.5 23 C31.8 23 32 24.5 32 25 C32 24.5 32.2 23 33.5 23 C39 23 42 31 32 38Z" fill="#fff"/>
      </svg>
    </button>
    <div>
      <h1>Everyone’s Voice Hub</h1>
      <p>Your voice matters to us. Your perspective belongs here.</p>
    </div>
  </div>
  <svg class="waves w1" viewBox="0 0 2400 120" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60 Q150 10 300 60 T600 60 T900 60 T1200 60 T1500 60 T1800 60 T2100 60 T2400 60 V120 H0Z"/></svg>
  <svg class="waves w2" viewBox="0 0 2400 120" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60 Q150 110 300 60 T600 60 T900 60 T1200 60 T1500 60 T1800 60 T2100 60 T2400 60 V120 H0Z"/></svg>
</header>

<nav aria-label="Main menu" id="nav">
  <button data-tab="home" class="on">Home</button>
  <button data-tab="share">Share your perspective</button>
  <button data-tab="public">Public voices</button>
  <button data-tab="settings">Accessibility</button>
  <button data-tab="family">Family feelings</button>
  <button data-tab="calm">Calm corner</button>
</nav>

<div id="msg" role="status" aria-live="polite"></div>

<main>

  <!-- HOME -->
  <section id="home" class="on">
    <div class="hero">
      <div class="txt">
        <h2>Your voice matters to us. Your perspective belongs here.</h2>
        <p>Share your experiences, ideas, needs and concerns. Together, we build a more inclusive community for everyone.</p>
        <button class="act" id="heroBtn">Share your perspective</button>
      </div>
      <div class="art">
        <img class="pic bob" alt="Four people of different ages and abilities talking and listening together: a woman, a man with sunglasses and a white cane, an older woman in a wheelchair, and a young man using sign language" src="data:image/jpeg;base64,">
      </div>
    </div>

    <div class="boxes">
      <div class="box">
        <h3>Accessible by design</h3>
        <ul>
          <li>Text</li><li>Voice</li><li>Drawings</li><li>Captions</li>
          <li>Transcripts</li><li>Read aloud</li><li>Keyboard navigation</li><li>Multilingual access</li>
        </ul>
      </div>
      <div class="box light">
        <h3>Your privacy, your choice</h3>
        <p>You choose how your contribution is shared and who can see it. You can also share anonymously.</p>
        <p><strong>Your voice is important. Your privacy is respected.</strong></p>
      </div>
    </div>
  </section>

  <!-- SHARE -->
  <section id="share">
    <h2>Share your perspective</h2>
    <p>Share your experiences, ideas, needs and concerns. Together, we build a more inclusive community for everyone.</p>

    <label>How would you like to share?</label>
    <div class="row">
      <label><input type="radio" name="way" value="text" checked> Type</label>
      <label><input type="radio" name="way" value="voice"> Speak</label>
      <label><input type="radio" name="way" value="drawing"> Draw</label>
    </div>

    <div id="textBox">
      <label for="thought">Your thoughts</label>
      <textarea id="thought" rows="5"></textarea>
    </div>

    <div id="voiceBox" class="hide">
      <button class="act" id="micBtn">Start speaking</button>
      <span id="micState"></span>
      <p>Your words appear above as a transcript. You can edit them before sending.</p>
    </div>

    <div id="drawBox" class="hide">
      <canvas id="pad" width="500" height="260" aria-label="Drawing area"></canvas><br>
      <button class="act alt" id="clearPad">Clear drawing</button>
      <label for="caption">Describe your drawing (text description)</label>
      <input id="caption">
    </div>

    <label for="privacy">Your privacy, your choice</label>
    <select id="privacy">
      <option value="public">Everyone can see (with my name)</option>
      <option value="private">Family only</option>
      <option value="anon">Share anonymously</option>
    </select>

    <div id="nameBox">
      <label for="name">Your name</label>
      <input id="name" placeholder="Leave empty to be Anonymous">
    </div>

    <button class="act" id="sendBtn">Share my voice</button>
  </section>

  <!-- PUBLIC -->
  <section id="public">
    <h2>Public voices</h2>
    <div id="publicList"></div>
  </section>

  <!-- SETTINGS -->
  <section id="settings">
    <h2>Accessibility</h2>
    <div class="row"><label><input type="checkbox" id="readAloud"> Read everything aloud</label></div>
    <label for="lang">Language (speaking and reading)</label>
    <select id="lang">
      <option value="en-US">English</option>
      <option value="ar-SA">Arabic</option>
      <option value="es-ES">Spanish</option>
      <option value="fr-FR">French</option>
      <option value="hi-IN">Hindi</option>
    </select>
    <label for="size">Text size</label>
    <select id="size">
      <option value="16">Normal</option>
      <option value="20">Large</option>
      <option value="26">Extra large</option>
    </select>
    <p>Keyboard navigation works with Tab, Enter and Space. Captions and transcripts are shown for all spoken content.</p>
  </section>

  <!-- FAMILY -->
  <section id="family">
    <h2>Family feelings</h2>
    <p>Understanding how each person in the family feels helps everyone feel heard. Everyone is different, so ask instead of assuming.</p>
    <div class="row" id="memberBtns" role="tablist" aria-label="Family members"></div>
    <div id="memberPanel"></div>
    <h3>Family-only voices</h3>
    <div id="familyVoices"></div>
  </section>

  <!-- CALM CORNER -->
  <section id="calm">
    <h2>Calm corner</h2>
    <p>Feeling stressed? Play a quick game to blow off steam. Nothing you do here is saved or shared.</p>
    <div class="row" id="calmMenu">
      <button class="act" data-calm="calmBubbles">Bubble Blitz</button>
      <button class="act alt" data-calm="calmWhack">Whack-a-Worry</button>
      <button class="act alt" data-calm="calmSmash">Smash It</button>
    </div>

    <div class="calmbox" id="calmBubbles">
      <div class="gbar"><span>Score: <span id="bScore">0</span></span><span>Time: <span id="bTime">30</span></span><span>Combo: <span id="bCombo">x1</span></span><span>Best: <span id="bBest">0</span></span></div>
      <div id="bubField"></div>
    </div>

    <div class="calmbox hide" id="calmWhack">
      <div class="gbar"><span>Score: <span id="wScore">0</span></span><span>Time: <span id="wTime">30</span></span><span>Best: <span id="wBest">0</span></span></div>
      <div id="whackWrap"><div id="whackGrid"></div></div>
    </div>

    <div class="calmbox hide" id="calmSmash">
      <label for="worry">What is bugging you? Type it, then smash it.</label>
      <input id="worry" maxlength="40">
      <button class="act" id="smashGo">Make it a target</button>
      <p id="smashMsg" role="status"></p>
      <div id="smashArea">
        <div id="hpBar" class="hide"><div id="hpFill"></div></div>
        <button id="smashBlock" class="hide"></button>
      </div>
    </div>

    <p>If things feel too big, talk to someone you trust, like a family member, friend or teacher.</p>
  </section>

</main>

<script>
(function () {
  var checkins = [];
  var KEY = "voice_hub_data";
  var voices = [];
  var nextId = 1;

  // ---------- helpers ----------
  function $(id) { return document.getElementById(id); }

  // ---------- shared storage (falls back to this device only) ----------
  var db = null, remote = {};
  function newId() { return "i" + Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }
  function fail() { notify("Your change could not be shared. Ask the owner for Contributor access."); }

  function syncOut() {
    if (!db) return;
    var all = {};
    voices.forEach(function (v) { all["voices/" + v.id] = v; });
    checkins.forEach(function (c) { all["checkins/" + c.id] = c; });
    Object.keys(all).forEach(function (k) {
      var j = JSON.stringify(all[k]);
      if (remote[k] !== j) { remote[k] = j; db.doc(k).set(JSON.parse(j)).catch(fail); }
    });
    Object.keys(remote).forEach(function (k) {
      if (!all[k]) { delete remote[k]; db.doc(k).delete().catch(fail); }
    });
  }

  function refreshView() {
    var cur = document.querySelector("section.on");
    if (!cur) return;
    var typing = document.activeElement && /INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName);
    if (cur.id === "public") renderPublic();
    else if (cur.id === "family" && !typing) renderFamily();
  }

  function ingest(name, snap) {
    var list = snap.docs.map(function (d) { return d.data(); });
    Object.keys(remote).forEach(function (k) { if (k.indexOf(name + "/") === 0) delete remote[k]; });
    list.forEach(function (x) { remote[name + "/" + x.id] = JSON.stringify(x); });
    if (name === "voices") voices = list; else checkins = list;
    refreshView();
  }

  function startShared() {
    if (!window.claude || !window.claude.use) return;
    window.claude.use("db").then(function (d) {
      if (!d) return;
      db = d;
      db.collection("voices").onSnapshot(function (snap) { ingest("voices", snap); }, function () {});
      db.collection("checkins").onSnapshot(function (snap) { ingest("checkins", snap); }, function () {});
    }).catch(function () {});
  }

  function save() {
    try { localStorage.setItem(KEY, JSON.stringify({ voices: voices, nextId: nextId, checkins: checkins })); }
    catch (e) { /* storage not allowed: works for this session only */ }
    syncOut();
  }
  function load() {
    try {
      var d = JSON.parse(localStorage.getItem(KEY));
      if (d) { voices = d.voices || []; checkins = d.checkins || []; nextId = d.nextId || voices.length + 1; }
    } catch (e) { voices = []; nextId = 1; }
  }

  function notify(text) {
    var m = $("msg");
    m.textContent = text;
    m.style.display = "block";
    setTimeout(function () { m.style.display = "none"; }, 4000);
    speak(text);
  }

  function speak(text) {
    if (!$("readAloud").checked || !window.speechSynthesis) return;
    window.speechSynthesis.cancel();
    var u = new SpeechSynthesisUtterance(text);
    u.lang = $("lang").value;
    window.speechSynthesis.speak(u);
  }

  function make(tag, text, cls) {
    var e = document.createElement(tag);
    if (text !== undefined) e.textContent = text;
    if (cls) e.className = cls;
    return e;
  }

  function voiceCard(v, extra) {
    var c = make("div", "", "card");
    c.appendChild(make("strong", v.name));
    c.appendChild(make("small", "  (" + v.kind + ", " + v.visibility + ")"));
    c.appendChild(make("p", v.text));
    if (v.image) {
      var img = make("img");
      img.src = v.image;
      img.alt = v.text;
      img.style.maxWidth = "100%";
      c.appendChild(img);
    }
    if (extra) extra(c);
    return c;
  }

  function readBtn(text) {
    var b = make("button", "Read aloud", "act alt");
    b.onclick = function () {
      if (!window.speechSynthesis) { notify("Read aloud is not supported in this browser."); return; }
      window.speechSynthesis.cancel();
      var u = new SpeechSynthesisUtterance(text);
      u.lang = $("lang").value;
      window.speechSynthesis.speak(u);
    };
    return b;
  }

  // ---------- tabs ----------
  var buttons = document.querySelectorAll("#nav button");
  function showTab(name) {
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].className = buttons[i].getAttribute("data-tab") === name ? "on" : "";
    }
    var secs = document.querySelectorAll("section");
    for (var j = 0; j < secs.length; j++) secs[j].className = secs[j].id === name ? "on" : "";
    if (name === "calm") showCalm("calmBubbles"); else stopCalm();
    if (name === "public") renderPublic();
    if (name === "family") renderFamily();
  }
  for (var i = 0; i < buttons.length; i++) {
    buttons[i].onclick = function () { showTab(this.getAttribute("data-tab")); };
  }

  // ---------- share: choose way ----------
  var wayRadios = document.getElementsByName("way");
  function currentWay() {
    for (var i = 0; i < wayRadios.length; i++) if (wayRadios[i].checked) return wayRadios[i].value;
    return "text";
  }
  function updateWay() {
    var w = currentWay();
    $("textBox").className = (w === "drawing") ? "hide" : "";
    $("voiceBox").className = (w === "voice") ? "" : "hide";
    $("drawBox").className = (w === "drawing") ? "" : "hide";
  }
  for (var r = 0; r < wayRadios.length; r++) wayRadios[r].onchange = updateWay;

  $("privacy").onchange = function () {
    $("nameBox").className = this.value === "anon" ? "hide" : "";
  };

  // ---------- speak (browser speech recognition) ----------
  var recognizer = null;
  $("micBtn").onclick = function () {
    var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SR) { notify("Voice input is not supported here. Please type instead."); return; }
    if (recognizer) { recognizer.stop(); return; }
    recognizer = new SR();
    recognizer.lang = $("lang").value;
    recognizer.interimResults = false;
    recognizer.onstart = function () { $("micState").textContent = "Listening..."; $("micBtn").textContent = "Stop"; };
    recognizer.onresult = function (ev) {
      var t = ev.results[0][0].transcript;
      $("thought").value = ($("thought").value + " " + t).trim();
      $("textBox").className = "";
      notify("Transcript: " + t);
    };
    recognizer.onerror = function () { notify("I could not hear anything. Please try again or type."); };
    recognizer.onend = function () {
      recognizer = null;
      $("micState").textContent = "";
      $("micBtn").textContent = "Start speaking";
    };
    recognizer.start();
  };

  // ---------- draw (canvas) ----------
  var pad = $("pad"), ctx = pad.getContext("2d"), down = false, drew = false;
  ctx.lineWidth = 4; ctx.lineCap = "round"; ctx.strokeStyle = "#2e7d32";
  function pos(e) {
    var r = pad.getBoundingClientRect();
    return { x: (e.clientX - r.left) * pad.width / r.width, y: (e.clientY - r.top) * pad.height / r.height };
  }
  pad.onpointerdown = function (e) { down = true; var p = pos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); };
  pad.onpointermove = function (e) { if (!down) return; var p = pos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); drew = true; };
  pad.onpointerup = pad.onpointerleave = function () { down = false; };
  $("clearPad").onclick = function () { ctx.clearRect(0, 0, pad.width, pad.height); drew = false; };

  // ---------- send ----------
  $("sendBtn").onclick = function () {
    var way = currentWay(), text = "", image = "";
    if (way === "drawing") {
      text = $("caption").value.trim();
      if (!drew) { notify("Please draw something first."); return; }
      if (text === "") { notify("Please describe your drawing."); return; }
      image = pad.toDataURL("image/png");
    } else {
      text = $("thought").value.trim();
      if (text === "") { notify("Nothing was captured. Please share your thoughts."); return; }
    }

    var p = $("privacy").value, name = $("name").value.trim();
    if (p === "anon" || name === "") name = "Anonymous";

    voices.push({
      id: newId(), name: name, kind: way, text: text, image: image,
      visibility: p === "private" ? "private" : "public", reply: ""
    });
    save();

    $("thought").value = ""; $("caption").value = ""; $("name").value = "";
    ctx.clearRect(0, 0, pad.width, pad.height); drew = false;
    notify("Thank you. Your voice is important and your privacy is respected.");
  };

  // ---------- public + updates ----------
  function renderPublic() {
    var box = $("publicList"); box.innerHTML = "";
    var list = voices.filter(function (v) { return v.visibility === "public"; });
    if (!list.length) { box.appendChild(make("p", "No public voices yet. Be the first to share.")); return; }
    list.forEach(function (v) {
      box.appendChild(voiceCard(v, function (c) { c.appendChild(readBtn(v.name + " says: " + v.text)); }));
    });
  }

  // ---------- settings ----------
  $("size").onchange = function () { document.body.style.fontSize = this.value + "px"; };
  $("readAloud").onchange = function () {
    if (this.checked) speak("Read aloud is now on.");
    else if (window.speechSynthesis) window.speechSynthesis.cancel();
  };

  // ---------- family feelings ----------
  var MEMBERS = [
    { key: "boys", label: "Boys", tips: [
      "Some boys find it hard to say feelings out loud. Try asking, “What was the hardest part of your day?”",
      "Listen first. Try not to fix or joke right away.",
      "Let them know it is okay to feel sad, scared or upset, not only angry or fine."
    ]},
    { key: "girls", label: "Girls", tips: [
      "Some girls feel pressure to be perfect or to keep everyone happy. Remind them mistakes are okay.",
      "Ask for their opinion and really listen to the answer.",
      "Notice effort and kindness, not only how they look or what grades they get."
    ]},
    { key: "teens", label: "Teens", tips: [
      "Many teens want more independence and privacy while still needing support. Knock first and ask before assuming.",
      "Listen without lecturing. Try, “Do you want advice, or do you just want me to listen?”",
      "School, friends, social media and the future can feel like a lot. Let them know their feelings are normal and you are on their side."
    ]},
    { key: "dad", label: "Dad", tips: [
      "Many dads carry worries about work and money and may not talk about them.",
      "Ask, “How are you really doing?” at a calm moment, not in the middle of a rush.",
      "Say thank you for the things he does. Small words of appreciation matter."
    ]},
    { key: "mom", label: "Mom", tips: [
      "Many moms juggle lots of jobs at once and can feel tired or unseen.",
      "Offer help before being asked, and take a task off her list.",
      "Say thank you and ask what she needs, not only what the family needs."
    ]}
  ];
  var FEELINGS = ["😊 Happy", "😢 Sad", "😠 Angry", "😟 Worried", "😴 Tired", "🌟 Proud", "😔 Lonely"];
  var currentMember = "boys", currentFeeling = "";

  function renderFamily() {
    // member buttons
    var mb = $("memberBtns"); mb.innerHTML = "";
    MEMBERS.forEach(function (m) {
      var b = make("button", m.label, "feel" + (m.key === currentMember ? " on" : ""));
      b.onclick = function () { currentMember = m.key; currentFeeling = ""; renderFamily(); };
      mb.appendChild(b);
    });

    var m = MEMBERS.filter(function (x) { return x.key === currentMember; })[0];
    var panel = $("memberPanel"); panel.innerHTML = "";

    // understanding tips
    var tips = make("div", "", "card");
    tips.appendChild(make("strong", "Understanding: " + m.label));
    m.tips.forEach(function (t) { tips.appendChild(make("p", t)); });
    tips.appendChild(readBtn(m.tips.join(" ")));
    panel.appendChild(tips);

    // check-in
    panel.appendChild(make("h3", "How are you feeling today? (" + m.label + ")"));
    var fr = make("div");
    FEELINGS.forEach(function (f) {
      var b = make("button", f, "feel" + (f === currentFeeling ? " on" : ""));
      b.onclick = function () { currentFeeling = f; renderFamily(); };
      fr.appendChild(b);
    });
    panel.appendChild(fr);

    var lab = make("label", "What do you need from your family?");
    lab.setAttribute("for", "need");
    var ta = make("textarea"); ta.id = "need"; ta.rows = 3;
    panel.appendChild(lab); panel.appendChild(ta);

    var save_b = make("button", "Save my check-in", "act");
    save_b.onclick = function () {
      if (!currentFeeling) { notify("Please choose how you feel first."); return; }
      checkins.push({
        id: newId(), member: currentMember, feeling: currentFeeling, need: ta.value.trim(),
        date: new Date().toLocaleDateString()
      });
      save(); currentFeeling = "";
      notify("Thank you for sharing. Your feelings matter.");
      renderFamily();
    };
    panel.appendChild(save_b);

    // saved check-ins
    panel.appendChild(make("h3", "Recent check-ins: " + m.label));
    var mine = checkins.filter(function (c) { return c.member === currentMember; }).reverse();
    if (!mine.length) panel.appendChild(make("p", "No check-ins yet."));
    mine.forEach(function (c) {
      var card = make("div", "", "card");
      card.appendChild(make("strong", c.feeling));
      card.appendChild(make("small", "  " + c.date));
      if (c.need) card.appendChild(make("p", "Needs: " + c.need));
      card.appendChild(readBtn(m.label + " feels " + c.feeling + ". " + (c.need ? "Needs: " + c.need : "")));
      var d = make("button", "Delete", "act alt");
      d.onclick = function () {
        checkins = checkins.filter(function (x) { return x !== c; });
        save(); renderFamily();
      };
      card.appendChild(d);
      panel.appendChild(card);
    });

    // family-only voices (with replies)
    var box = $("familyVoices"); box.innerHTML = "";
    var priv = voices.filter(function (v) { return v.visibility === "private"; });
    if (!priv.length) box.appendChild(make("p", "No family-only voices yet."));
    priv.forEach(function (v) {
      box.appendChild(voiceCard(v, function (c) {
        var inp = make("input"); inp.placeholder = "Write a caring reply"; inp.value = v.reply || "";
        var b = make("button", "Save reply", "act");
        b.onclick = function () { v.reply = inp.value.trim(); save(); notify("Reply saved."); };
        c.appendChild(inp); c.appendChild(b);
      }));
    });
  }

  $("heroBtn").onclick = function () { showTab("share"); };

  // ---------- calm corner games ----------
  var bubTimer = null, bubClock = null, whackTimer = null, whackClock = null;
  var best = { bubble: 0, whack: 0 }, smashed = 0;
  var POPCOLORS = ["#a8d5e2", "#cfe3b4", "#f4b6c2", "#c9b8e8", "#ffd6a5"];

  function stopCalm() {
    if (bubTimer) clearInterval(bubTimer);
    if (bubClock) clearInterval(bubClock);
    if (whackTimer) clearInterval(whackTimer);
    if (whackClock) clearInterval(whackClock);
    bubTimer = bubClock = whackTimer = whackClock = null;
  }
  function showOverlay(host, text, label, fn) {
    var o = make("div", "", "overlay");
    o.appendChild(make("p", text));
    var b = make("button", label, "act");
    b.onclick = function () { o.remove(); fn(); };
    o.appendChild(b); host.appendChild(o);
  }

  // --- Bubble Blitz ---
  var bScore = 0, bTime = 30, bCombo = 1, bLast = 0;
  function bubbleHud() {
    $("bScore").textContent = bScore; $("bTime").textContent = bTime;
    $("bCombo").textContent = "x" + bCombo; $("bBest").textContent = best.bubble;
  }
  function prepBubbles() {
    stopCalm(); bScore = 0; bTime = 30; bCombo = 1; bubbleHud();
    var f = $("bubField"); f.innerHTML = "";
    showOverlay(f, "Pop as many bubbles as you can in 30 seconds. Small bubbles score more. Pop quickly for combos, and grab the gold ★ for bonus time.", "Start", startBubbles);
  }
  function endBubbles() {
    stopCalm();
    if (bScore > best.bubble) best.bubble = bScore;
    bubbleHud();
    var f = $("bubField"); f.innerHTML = "";
    showOverlay(f, "Time’s up! Score: " + bScore, "Play again", startBubbles);
  }
  function startBubbles() {
    stopCalm(); bScore = 0; bTime = 30; bCombo = 1; bLast = 0; bubbleHud();
    var f = $("bubField"); f.innerHTML = "";
    bubClock = setInterval(function () { bTime--; bubbleHud(); if (bTime <= 0) endBubbles(); }, 1000);
    bubTimer = setInterval(function () {
      var gold = Math.random() < 0.1, size = gold ? 46 : 36 + Math.random() * 38;
      var b = make("button", gold ? "★" : "", "pop" + (gold ? " gold" : ""));
      b.style.width = size + "px"; b.style.height = size + "px";
      b.style.left = Math.max(0, Math.random() * (f.clientWidth - size)) + "px";
      b.style.setProperty("--d", (2.6 + Math.random() * 2) + "s");
      if (!gold) b.style.background = POPCOLORS[Math.floor(Math.random() * POPCOLORS.length)];
      b.setAttribute("aria-label", gold ? "Gold bubble, bonus time" : "Pop bubble");
      b.onclick = function () {
        var now = Date.now();
        bCombo = (now - bLast < 1000) ? Math.min(bCombo + 1, 5) : 1; bLast = now;
        bScore += (gold ? 50 : Math.round(60 - size * 0.6)) * bCombo;
        if (gold) bTime += 3;
        b.remove(); bubbleHud();
      };
      b.addEventListener("animationend", function () { if (b.parentNode) { b.remove(); bCombo = 1; bubbleHud(); } });
      f.appendChild(b);
    }, 480);
  }

  // --- Whack-a-Worry ---
  var wScore = 0, wTime = 30, holes = [], WORRIES = ["😠", "😰", "😤", "😟"];
  function whackHud() { $("wScore").textContent = wScore; $("wTime").textContent = wTime; $("wBest").textContent = best.whack; }
  function clearHoles() { holes.forEach(function (h) { h.dataset.kind = ""; h.textContent = ""; }); }
  function buildHoles() {
    if (holes.length) return;
    for (var i = 0; i < 9; i++) {
      var h = make("button", "", "hole");
      h.setAttribute("aria-label", "Hole");
      h.onclick = function () {
        var k = this.dataset.kind, me = this;
        if (!k) return;
        this.dataset.kind = "";
        if (k === "worry") { wScore += 10; this.textContent = "💥"; } else { wScore = Math.max(0, wScore - 15); this.textContent = "💔"; }
        whackHud();
        setTimeout(function () { if (!me.dataset.kind) me.textContent = ""; }, 250);
      };
      holes.push(h); $("whackGrid").appendChild(h);
    }
  }
  function prepWhack() {
    stopCalm(); buildHoles(); clearHoles(); wScore = 0; wTime = 30; whackHud();
    showOverlay($("whackWrap"), "Whack the worries 😠 as they pop up. Don’t hit the hearts 💚. You have 30 seconds.", "Start", startWhack);
  }
  function endWhack() {
    stopCalm(); clearHoles();
    if (wScore > best.whack) best.whack = wScore;
    whackHud();
    showOverlay($("whackWrap"), "Time’s up! Score: " + wScore, "Play again", startWhack);
  }
  function startWhack() {
    stopCalm(); clearHoles(); wScore = 0; wTime = 30; whackHud();
    whackClock = setInterval(function () { wTime--; whackHud(); if (wTime <= 0) endWhack(); }, 1000);
    whackTimer = setInterval(function () {
      var h = holes[Math.floor(Math.random() * holes.length)];
      if (h.dataset.kind) return;
      var heart = Math.random() < 0.2;
      h.dataset.kind = heart ? "heart" : "worry";
      h.textContent = heart ? "💚" : WORRIES[Math.floor(Math.random() * WORRIES.length)];
      setTimeout(function () { if (h.dataset.kind) { h.dataset.kind = ""; h.textContent = ""; } }, Math.max(450, 900 - (30 - wTime) * 15));
    }, 550);
  }

  // --- Smash It ---
  var smashHP = 0, BITS = ["💥", "✨", "⭐"];
  function burst() {
    var box = $("smashArea");
    for (var i = 0; i < 14; i++) {
      (function (i) {
        var b = make("span", BITS[i % 3], "bit"); box.appendChild(b);
        setTimeout(function () {
          b.style.transform = "translate(" + (Math.random() * 240 - 120) + "px," + (Math.random() * 200 - 100) + "px) rotate(" + (Math.random() * 360) + "deg)";
          b.style.opacity = "0";
        }, 20);
        setTimeout(function () { b.remove(); }, 900);
      })(i);
    }
  }
  $("smashGo").onclick = function () {
    var txt = $("worry").value.trim();
    if (!txt) { notify("Type what is bugging you first."); return; }
    $("worry").value = ""; smashHP = 8;
    var blk = $("smashBlock");
    blk.textContent = txt; blk.className = "";
    $("hpBar").className = ""; $("hpFill").style.width = "100%";
    $("smashMsg").textContent = "Click it 8 times to smash it!";
  };
  $("smashBlock").onclick = function () {
    if (smashHP <= 0) return;
    smashHP--;
    $("hpFill").style.width = (smashHP / 8 * 100) + "%";
    var b = this; b.classList.remove("hit"); void b.offsetWidth; b.classList.add("hit");
    if (smashHP === 0) {
      burst(); b.className = "hide"; $("hpBar").className = "hide"; smashed++;
      $("smashMsg").textContent = "Smashed! 💥 Worries smashed: " + smashed;
    }
  };

  function showCalm(id) {
    stopCalm();
    ["calmBubbles", "calmWhack", "calmSmash"].forEach(function (x) { $(x).className = x === id ? "calmbox" : "calmbox hide"; });
    var bs = document.querySelectorAll("#calmMenu button");
    for (var i = 0; i < bs.length; i++) bs[i].className = "act" + (bs[i].getAttribute("data-calm") === id ? "" : " alt");
    if (id === "calmBubbles") prepBubbles();
    if (id === "calmWhack") prepWhack();
  }
  var cbs = document.querySelectorAll("#calmMenu button");
  for (var ci = 0; ci < cbs.length; ci++) cbs[ci].onclick = function () { showCalm(this.getAttribute("data-calm")); };

  $("logoBtn").onclick = function () { showTab("home"); window.scrollTo(0, 0); };

  // ---------- start ----------
  load();
  startShared();
  updateWay();
  notify("Welcome to Everyone’s Voice Hub.");
})();
</script>
</body>
</html>
